#!/bin/sh
# Cursor++ BYOK —— pre-commit 构建门禁
#
# 提交前强制跑类型检查 / lint / 单元测试 / 生产构建，任一失败即拒绝提交。
# 目的：CI 上才发现的构建错误不应该进仓库；线上 Release 只由已通过的提交产出。
#
# 安装：node scripts/install-hooks.mjs
# 绕过：git commit --no-verify（仅限确实需要时，例如只改文档）
#
# 只在本仓库有实际源码改动时运行；纯文档提交（如只改 README）也会跑，
# 因为门禁本身只要几秒，比"漏检一次"的代价低。

set -e

repo_root="$(git rev-parse --show-toplevel)"

# 扩展源码不在仓库根目录，构建门禁针对 Cursor++/ 子目录
extension_dir="$repo_root/Cursor++"
if [ ! -f "$extension_dir/package.json" ]; then
  echo "[hook] Cursor++/package.json not found, skipping build gate"
  exit 0
fi

# node_modules 缺失时（例如刚 clone）不阻塞提交，但明确提示
if [ ! -d "$extension_dir/node_modules" ]; then
  echo "[hook] Cursor++/node_modules missing — run 'pnpm install' in Cursor++/ to enable the build gate."
  echo "[hook] Skipping build gate for this commit."
  exit 0
fi

echo "[hook] Running build gate (typecheck + lint + tests + build)…"
if ! (cd "$extension_dir" && node scripts/verify.mjs); then
  echo ""
  echo "[hook] Commit rejected: build gate failed."
  echo "[hook] Fix the errors above, or bypass with 'git commit --no-verify' (not recommended)."
  exit 1
fi

echo "[hook] Build gate passed."
